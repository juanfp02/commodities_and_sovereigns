               <rdf:value>Default probability</rdf:value>
            </z:AutomaticTag>
        </dc:subject>
        <dc:subject>
            <z:AutomaticTag>
               <rdf:value>Sovereign credit risk</rdf:value>
            </z:AutomaticTag>
