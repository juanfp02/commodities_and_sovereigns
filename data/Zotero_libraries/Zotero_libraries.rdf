    <bib:Article rdf:about="https://www.sciencedirect.com/science/article/pii/S0167668703001719">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0167-6687"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Chen</foaf:surname>
                        <foaf:givenName>Cho-Jieh</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Panjer</foaf:surname>
                        <foaf:givenName>Harry</foaf:givenName>
                    </foaf:Person>
